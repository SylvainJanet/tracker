{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "types": ["node"],
    "verbatimModuleSyntax": false
  },
  "include": ["eslint/architecture/**/*.d.ts", "eslint/architecture/**/*.js"]
}
